# Local development only. Copy to .env (ignored by Git).
# No public hostnames, production credentials, or provider keys belong here.
# Generate a unique local password before starting Compose. Keep it URL-safe.
POSTGRES_PASSWORD=replace-with-a-unique-local-password
# Compose maps this password to GODFATHER_DATABASE_PASSWORD for API/migrations.
# For native API development, explicitly set GODFATHER_DATABASE_HOST, _PORT,
# _NAME, _USER and _PASSWORD in the terminal. No database host port is published
# by default. Prefer the container workflow in docs/operations/phase-02.md.

# Worker health: heartbeat < suspect < offline. All values are seconds.
GODFATHER_HEARTBEAT_INTERVAL_SECONDS=10
GODFATHER_SUSPECT_AFTER_SECONDS=20
GODFATHER_OFFLINE_AFTER_SECONDS=30
GODFATHER_HEALTH_SCAN_SECONDS=1
# Worker/admin tokens are generated per identity into ignored private files.
# Never put them in tracked configuration or reuse an administrator token on a node.

# Phase 04: synthetic execution leases; maintenance uses the health scan interval.
GODFATHER_EXECUTION_LEASE_SECONDS=30
GODFATHER_SCHEDULER_ENABLED=true

# Phase 09 Google OIDC. Configure a Google OAuth Web client separately; no default
# account or Google credentials are supplied. Never commit the populated .env.
GODFATHER_WEB_ORIGIN=http://127.0.0.1:3000
GODFATHER_ENVIRONMENT=local
GODFATHER_GOOGLE_CLIENT_ID=
GODFATHER_GOOGLE_CLIENT_SECRET=
# First login only, on a database with no administrator/Google identity. Obtain
# the stable sub from a verified Google identity; email alone cannot bootstrap.
GODFATHER_GOOGLE_BOOTSTRAP_SUBJECT=
GODFATHER_GOOGLE_BOOTSTRAP_EMAIL=
GODFATHER_SESSION_SECONDS=28800
GODFATHER_AUTHENTICATION_LIMIT=20
# Native frontend: put GODFATHER_WEB_ORIGIN and GODFATHER_API_URL in the process
# environment or ignored apps/dashboard/.env.local; no NEXT_PUBLIC secret values.
# Planned production redirect: https://app.the-godfather.ai/api/auth/callback
# Local redirect: http://127.0.0.1:3000/api/auth/callback
