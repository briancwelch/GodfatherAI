# Local development only. Copy to .env (ignored by Git).
# No public hostnames, production credentials, or provider keys belong here.
# Generate a unique local password before starting Compose. Keep it URL-safe.
POSTGRES_PASSWORD=replace-with-a-unique-local-password
# Compose maps this password to GODFATHER_DATABASE_PASSWORD for API/migrations.
# For native API development, explicitly set GODFATHER_DATABASE_HOST, _PORT,
# _NAME, _USER and _PASSWORD in the terminal. No database host port is published
# by default. Prefer the container workflow in docs/operations/phase-02.md.
