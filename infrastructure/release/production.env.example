# Install privately at /opt/the-godfather/production.env, outside releases.
# Owner: approved root/Docker operator. Mode: 600. Never commit populated values.
# See docs/operations/production-readiness-2026-10-20.md for operator procedures.
# Required: generate at least 32 random URL-safe bytes; never reuse the local .env.
POSTGRES_PASSWORD=
# Required: dedicated production Google Web application client credentials.
GODFATHER_GOOGLE_CLIENT_ID=
GODFATHER_GOOGLE_CLIENT_SECRET=
# Optional pair after onboarding; required to bootstrap the first empty installation.
# Verify sub independently, never email alone. Clear BOTH after first login.
# Existing accounts require explicit identity linking; preserve their UUIDs.
GODFATHER_GOOGLE_BOOTSTRAP_SUBJECT=
GODFATHER_GOOGLE_BOOTSTRAP_EMAIL=
# Required: monitored certificate contact email (not a secret).
ACME_EMAIL=
