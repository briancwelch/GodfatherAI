{
	email {$ACME_EMAIL}
	# No access log: OAuth codes/cookies must not enter request logs.
}

{$GODFATHER_PUBLIC_HOSTS:app.the-godfather.ai api.the-godfather.ai} {
	request_body {
		max_size 2MB
	}
	header Strict-Transport-Security "max-age=31536000"
	@downloads path /downloads/manifest.json /downloads/godfather-worker-*-setup.exe /downloads/godfather-worker-*-installer.dmg /downloads/consigliere-*-setup.exe /downloads/consigliere-*-installer.dmg
	handle @downloads {
		root * /srv/godfather-downloads
		uri strip_prefix /downloads
		file_server
	}
	# Only authenticated worker operations and Google-approved pairing are public.
	@worker path /api/v1/workers /api/v1/workers/*
	handle @worker {
		reverse_proxy api:8000 {
			header_up X-Godfather-Proxy-Token {$GODFATHER_PROXY_TOKEN}
			header_up X-Godfather-Peer {remote_host}
		}
	}
	@web host {$GODFATHER_APP_HOST:app.the-godfather.ai}
	handle @web {
		reverse_proxy dashboard:3000
	}
	# Browser sessions use the same-origin dashboard bridge. No public API bypass.
	respond 404
}
